# CodeForge AI Environment Configuration Template

# System Listen Host and Port
HOST=0.0.0.0
PORT=8000

# LLM Selection Settings (For internal module planning, unexposed in API)
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-pro
OPENAI_MODEL=gpt-4o

# API Keys (Provide your actual keys here)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# API Secret Key for Authentication (Required single shared secret)
API_SECRET_KEY=your_api_secret_key_here

# CORS Allowed Origins (Comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000


